# Immich configuration for the DS225+ NAS. The real file is /volume1/docker/immich/.env (mode 600).
UPLOAD_LOCATION=/volume1/docker/immich/library
DB_DATA_LOCATION=/volume1/docker/immich/postgres
TZ=Europe/Amsterdam
# Pinned deliberately. Immich database migrations are one-way; do not float this tag.
IMMICH_VERSION=v3.1.0
DB_PASSWORD=<generate a random password; only letters and digits>
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
