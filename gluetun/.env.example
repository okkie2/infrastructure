# Copy to /volume1/docker/gluetun/.env on the NAS and chmod 600. Never commit the real file.

# AirVPN (active): from the AirVPN Config Generator (WireGuard). IPv4 address only.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=

# NordVPN (optional fallback for docker-compose.nordvpn.yml): from the NordVPN API using an access token.
NORDVPN_WIREGUARD_PRIVATE_KEY=
