# Managed by Ansible (hetzner/ansible/roles/ssh_hardening). Do not edit on the host.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
AllowUsers {{ admin_user }}{% if backup_nas_public_key | default('') | length > 0 %} {{ backup_user }}@{{ backup_nas_source_ip }}{% endif %}

X11Forwarding no
MaxAuthTries 3
