config_version: 1

control_plane:
  tunnel_id: "<redacted: replace with the NAS value>"
  api_key: file:/run/secrets/control-plane-api-key

mcp:
  server_urls:
    - channel: main
      url: http://100.126.55.95:8766/mcp
  extra_headers:
    Authorization: file:/run/secrets/volition-authorization

log:
  level: info
  format: json

health:
  listen_addr: 127.0.0.1:8080
