# Managed by Ansible (hetzner/ansible/roles/backup). Do not edit on the host.
[Unit]
Description=Nightly database dump, before OK040 fetches it at 07:30

[Timer]
# Local time, outside 02:00-03:00 so the spring daylight-saving jump never skips it.
OnCalendar=*-*-* {{ backup_time }}:00
Persistent=true

[Install]
WantedBy=timers.target
